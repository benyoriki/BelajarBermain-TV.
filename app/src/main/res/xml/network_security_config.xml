<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS wajib. Sertifikat diperiksa seperti biasa (sistem); tidak ada pengecualian/pinning palsu. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
